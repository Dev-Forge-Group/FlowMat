# Copy to .env next to compose.yaml and keep it to the owner: cp env.example .env && chmod 600 .env
# Never commit or send .env. The application reads this whole file; compose.yaml works out the database, Redis and
# address settings from the values below.

# The site's name. Its DNS A record must point at this machine before the first start (Caddy gets the certificate).
FLOWMAT_DOMAIN=flowmat.example.com

# Database. Make the password long and random, e.g.: openssl rand -base64 36
POSTGRES_DB=flowmat
POSTGRES_USER=flowmat
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 random characters, e.g.: openssl rand -base64 48
JWT_SECRET=

# Mail for sign-up codes and password resets (the sending service's SMTP settings). Required at startup.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional. Memory for the application (a 4 GB machine; use -Xmx768m on 2 GB).
# APP_JAVA_OPTS=-Xms256m -Xmx1g

# Optional, defaults shown. Leave the drafting AI off until its evaluation is approved (docs/domain/process-draft-evaluation.md)
# and the personal data sweep off until the periods pass legal review (docs/operations/personal-data.md §5).
# APP_AI_PROCESS_DRAFT_ENABLED=false
# APP_PRIVACY_SWEEP_CRON=-

# Optional sign-in with Google or Kakao: set both values of a provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
